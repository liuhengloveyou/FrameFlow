#!/bin/bash
# FrameFlow 普通应用启停脚本（非 Docker）
# 依赖：将 linux/amd64 二进制放到 ${TRIM_APPDEST}/server/FrameFlow

set -u

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
BIN="${TRIM_APPDEST}/server/FrameFlow"

CONF="${TRIM_PKGETC}/frameflow.yaml"
DEFAULT_CONF="${TRIM_APPDEST}/server/frameflow.yaml"

PASSPORT_CONF="${TRIM_PKGETC}/passport.conf.yaml"
DEFAULT_PASSPORT="${TRIM_APPDEST}/server/passport.conf.yaml"

RBAC_CONF="${TRIM_PKGETC}/rbac_with_domains_model.conf"
DEFAULT_RBAC="${TRIM_APPDEST}/server/rbac_with_domains_model.conf"

log_msg() {
    mkdir -p "$(dirname "${LOG_FILE}")"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

install_default() {
    local dest=$1
    local src=$2
    if [ -f "${dest}" ]; then
        return 0
    fi
    if [ -f "${src}" ]; then
        cp -f "${src}" "${dest}"
        log_msg "installed default config -> ${dest}"
        return 0
    fi
    log_msg "WARN: default config missing: ${src}"
    return 1
}

ensure_dirs() {
    mkdir -p "${TRIM_PKGVAR}/data/models" \
             "${TRIM_PKGVAR}/data/alarm-evidence" \
             "${TRIM_PKGVAR}/logs" \
             "${TRIM_PKGETC}"

    install_default "${CONF}" "${DEFAULT_CONF}" || true
    install_default "${PASSPORT_CONF}" "${DEFAULT_PASSPORT}" || true
    install_default "${RBAC_CONF}" "${DEFAULT_RBAC}" || true

    # passport InitAccessControl 固定读工作目录下的 rbac_with_domains_model.conf
    if [ -f "${RBAC_CONF}" ]; then
        ln -sfn "${RBAC_CONF}" "${TRIM_PKGVAR}/rbac_with_domains_model.conf"
    fi
}

check_process() {
    local pid=$1
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        return 0
    fi
    return 1
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

start_process() {
    if status; then
        return 0
    fi

    ensure_dirs

    if [ ! -x "${BIN}" ]; then
        log_msg "ERROR: binary not found or not executable: ${BIN}"
        return 1
    fi
    if [ ! -f "${CONF}" ]; then
        log_msg "ERROR: config missing: ${CONF}"
        return 1
    fi
    if [ ! -f "${PASSPORT_CONF}" ]; then
        log_msg "ERROR: passport config missing: ${PASSPORT_CONF}"
        return 1
    fi
    if [ ! -f "${RBAC_CONF}" ]; then
        log_msg "ERROR: rbac model missing: ${RBAC_CONF}"
        return 1
    fi

    log_msg "Starting FrameFlow: ${BIN} -c ${CONF} -passport ${PASSPORT_CONF}"
    (
        cd "${TRIM_PKGVAR}" || exit 1
        # 打包进 app/server/lib 的 FFmpeg / ONNX 等共享库
        export LD_LIBRARY_PATH="${TRIM_APPDEST}/server/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        export PASSPORT_CONFIG="${PASSPORT_CONF}"
        if [ -f "${TRIM_APPDEST}/server/lib/libonnxruntime.so" ]; then
            export ONNXRUNTIME_SHARED_LIBRARY_PATH="${TRIM_APPDEST}/server/lib/libonnxruntime.so"
        elif ls "${TRIM_APPDEST}/server/lib"/libonnxruntime.so.* >/dev/null 2>&1; then
            export ONNXRUNTIME_SHARED_LIBRARY_PATH="$(ls "${TRIM_APPDEST}/server/lib"/libonnxruntime.so.* | head -1)"
        fi
        exec "${BIN}" -c "${CONF}" -passport "${PASSPORT_CONF}"
    ) >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"
    sleep 1
    if status; then
        log_msg "started pid=$(cat "${PID_FILE}")"
        return 0
    fi
    log_msg "ERROR: process exited immediately, see ${LOG_FILE}"
    return 1
}

stop_process() {
    log_msg "Stopping process ..."
    if [ ! -r "${PID_FILE}" ]; then
        return 0
    fi

    pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    if ! check_process "${pid}"; then
        rm -f "${PID_FILE}"
        return 0
    fi

    kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1 || true
    local count=0
    while check_process "${pid}" && [ $count -lt 15 ]; do
        sleep 1
        count=$((count + 1))
    done
    if check_process "${pid}"; then
        kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1 || true
        sleep 1
    fi
    rm -f "${PID_FILE}"
    return 0
}

case $1 in
start)
    start_process
    exit $?
    ;;
stop)
    stop_process
    exit $?
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
